# ===========================
# BCOS Platform — Environment
# ===========================

# Database
DATABASE_URL=postgresql+asyncpg://bcos:bcos_secret@postgres:5432/bcos
POSTGRES_USER=bcos
POSTGRES_PASSWORD=bcos_secret
POSTGRES_DB=bcos

# Redis
REDIS_URL=redis://redis:6379

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# Chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=bcos_knowledge

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Backend
APP_ENV=development
DEBUG=true
# REQUIRED — app will refuse to start without this. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_STRING
KNOWLEDGE_BASE_PATH=./data/business_context
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# First superuser bootstrap — REQUIRED, no code default
FIRST_SUPERUSER_EMAIL=admin@yourcompany.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=9000

# OpenAI (optional — LLM compilation is disabled by default)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo
